# ==========================================================
# Tensorlake Sandbox Python Examples
# Environment Variables
# ==========================================================

# Tensorlake API Key
TENSORLAKE_API_KEY=your_tensorlake_api_key_here

# Optional: Tensorlake API URL
# Default: https://api.tensorlake.ai
# TENSORLAKE_API_URL=https://api.tensorlake.ai

# Optional: Organization ID
# TENSORLAKE_ORGANIZATION_ID=

# Optional: Project ID
# TENSORLAKE_PROJECT_ID=

# Optional: Namespace
# TENSORLAKE_NAMESPACE=default